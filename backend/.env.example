APP_NAME=AI Warehouse Safety Inspector
APP_VERSION=1.0.0
DATABASE_URL=postgresql://postgres:password@localhost:5432/warehouse_ai
MODEL_PATH=models/
LOG_LEVEL=INFO

STREAM_SOURCE=0
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/warehouse_ai

# OpenCV capture backend for webcam sources: auto (default), dshow, msmf.
# "auto" prefers DirectShow on Windows, where MSMF often fails to grab
# frames; it has no effect on file/URL sources or on Linux/macOS.
CAMERA_BACKEND=auto