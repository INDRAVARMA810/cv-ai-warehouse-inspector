# =====================================================================
# Line-ending policy.
#
# This repository is developed on Windows (core.autocrlf=true) but its
# containers run Linux. A shell script checked out with CRLF fails at
# runtime with a confusing "no such file or directory", because the
# kernel reads the shebang as "/bin/sh\r". These rules pin LF for every
# file that is executed or parsed inside a container.
# =====================================================================

# Sensible default: normalise text in the repository, let git decide
# the working-copy ending for everything not pinned below.
* text=auto

# Must be LF — executed or read inside Linux containers
*.sh              text eol=lf
Dockerfile        text eol=lf
*.Dockerfile      text eol=lf
.dockerignore     text eol=lf
docker-compose*.yml text eol=lf
*.conf            text eol=lf
*.conf.template   text eol=lf
docker/**/*.sql   text eol=lf

# Windows-native tooling keeps CRLF
*.bat             text eol=crlf
*.cmd             text eol=crlf
*.ps1             text eol=crlf

# Binary assets — never touched
*.png             binary
*.jpg             binary
*.jpeg            binary
*.mp4             binary
*.avi             binary
*.pt              binary
*.pth             binary
*.onnx            binary
*.ico             binary
