# Base URL the dashboard calls. Left as a relative path, requests go
# through the Vite dev proxy defined in vite.config.ts.
VITE_API_BASE_URL=/api/v1

# Backend origin the dev proxy forwards to.
VITE_BACKEND_URL=http://127.0.0.1:8000

# --- Live video stream (backend) -------------------------------------
# Configured on the BACKEND process, not here. Listed for reference:
#   STREAM_SOURCE=0                  # webcam index, or a path to a video file
#   STREAM_WEIGHTS=yolov8n.pt
#   STREAM_DEVICE=cuda               # omit to auto-select
#   STREAM_WIDTH=960
#   STREAM_HEIGHT=540
#   STREAM_AUTO_START=true           # start capture on the first viewer
#   STREAM_IDLE_STOP=60              # release the camera after N idle seconds
