# =========================================================
# AI Warehouse Safety Inspector — .gitignore
#
# Organized by concern. Rules are the union of the project's
# curated set and the standard GitHub Python template, with
# duplicates removed.
# =========================================================

# ---------------------------------------------------------
# Python
# ---------------------------------------------------------
__pycache__/
# *.py[cod] covers *.pyc, *.pyo and *.pyd
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.installed.cfg
MANIFEST
*.sage.py
cython_debug/
__pypackages__/

# ---------------------------------------------------------
# Build & Distribution Artifacts
# ---------------------------------------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
pip-wheel-metadata/
target/
.pybuilder/

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# ---------------------------------------------------------
# Testing, Coverage & Type Checking
# ---------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
cover/
.hypothesis/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ---------------------------------------------------------
# Virtual Environments
# ---------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
virtualenv/
.python-version
.envrc

# ---------------------------------------------------------
# Environment Files & Secrets
#   .env.example is deliberately tracked as the config template.
# ---------------------------------------------------------
.env
.env.*
*.env
.env.local
.env.*.local
!.env.example
secrets/
*.pem
*.key
.pypirc
.streamlit/secrets.toml
local_settings.py

# ---------------------------------------------------------
# IDEs & Editors
# ---------------------------------------------------------

# VS Code — keep shared workspace config, ignore per-user state
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
tempCodeRunnerFile.py

# PyCharm / JetBrains
.idea/

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject

# Vim / general editors
*.swp
*.swo
*~

# ---------------------------------------------------------
# Jupyter & Notebooks
# ---------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# ---------------------------------------------------------
# Logs
# ---------------------------------------------------------
*.log
logs/

# ---------------------------------------------------------
# PyTorch / YOLO / ML Models
#   Model directories are root-anchored so the Python package
#   backend/app/models/ is NOT ignored.
# ---------------------------------------------------------
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.hdf5
*.pb
*.tflite
*.pkl
*.pickle
*.safetensors
/models/
/weights/
checkpoints/
runs/
lightning_logs/
wandb/
mlruns/

# ---------------------------------------------------------
# Datasets
#   Ignore dataset contents but keep the scaffold directory.
# ---------------------------------------------------------
/datasets/*
!/datasets/.gitkeep

# ---------------------------------------------------------
# Databases
# ---------------------------------------------------------
*.sqlite3
*.sqlite3-journal
*.db

# ---------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------
*.sql.gz
*.dump
*.backup
pgdata/
postgres-data/

# ---------------------------------------------------------
# Docker
# ---------------------------------------------------------
docker-compose.override.yml
.docker/
*.pid

# ---------------------------------------------------------
# Services & Message Queues
# ---------------------------------------------------------

# Celery
celerybeat-schedule
celerybeat.pid

# Redis
*.rdb
*.aof

# RabbitMQ
mnesia/
rabbitmq/
rabbitmq-data/

# ActiveMQ
activemq-data/

# ---------------------------------------------------------
# Web Frameworks
# ---------------------------------------------------------

# Flask
instance/
.webassets-cache

# Scrapy
.scrapy

# Translations
*.mo
*.pot

# ---------------------------------------------------------
# Documentation
# ---------------------------------------------------------
docs/_build/
/site

# ---------------------------------------------------------
# Packaging & Dependency Managers
#   Lock files (Pipfile.lock, uv.lock, poetry.lock, pdm.lock,
#   pixi.lock) are intentionally NOT ignored — commit them for
#   reproducible builds.
# ---------------------------------------------------------
.pdm-python
.pdm-build/
.pixi

# Abstra — contains user credentials and local state
.abstra/

# ---------------------------------------------------------
# Operating System Files
# ---------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# ---------------------------------------------------------
# Archives
# ---------------------------------------------------------
*.zip
*.tar.gz
*.rar
