# =====================================================================
# Docker Compose configuration
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Every value has a working default in docker-compose.yml; this file
# exists so a deployment can override them without editing compose.
# =====================================================================

# --- PostgreSQL ------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=warehouse_ai
# Bound to loopback by default. Use "5432" to expose on all interfaces.
POSTGRES_PORT=127.0.0.1:5432

# --- Application -----------------------------------------------------
APP_NAME=AI Warehouse Safety Inspector
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# --- Database pooling ------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Startup behaviour -----------------------------------------------
WAIT_FOR_DB=90
RUN_MIGRATIONS=true
# Insert demo alerts/tracks/events on an empty database.
SEED_DEMO_DATA=false

# --- Live video stream -----------------------------------------------
# A webcam index, or a path INSIDE the container. Host footage placed in
# ./videos is mounted read-only at /app/videos.
#   STREAM_SOURCE=/app/videos/warehouse.mp4
STREAM_SOURCE=0
STREAM_WEIGHTS=yolov8n.pt
# Leave blank to auto-select (CUDA when available, else CPU).
STREAM_DEVICE=
STREAM_WIDTH=960
STREAM_HEIGHT=540
STREAM_AUTO_START=true
STREAM_IDLE_STOP=60

# --- Frontend --------------------------------------------------------
FRONTEND_PORT=8080
VITE_API_BASE_URL=/api/v1

# --- Torch build -----------------------------------------------------
# CPU wheels by default. For GPU use docker-compose.gpu.yml instead of
# changing this by hand.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
